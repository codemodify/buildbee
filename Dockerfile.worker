# BuildBee worker: runs agent Runs next to a Docker daemon.
FROM golang:1.27-alpine AS build
WORKDIR /src
ENV GOTOOLCHAIN=local CGO_ENABLED=0
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN go build -trimpath -o /out/buildbee-worker ./cmd/buildbee-worker

FROM alpine:3.24
RUN apk add --no-cache ca-certificates docker-cli git
COPY --from=build /out/buildbee-worker /usr/local/bin/buildbee-worker
EXPOSE 8090
ENV BUILDBEE_WORKER_ADDR=:8090
CMD ["buildbee-worker"]
