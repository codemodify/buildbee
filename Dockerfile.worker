# BuildBee worker: claims Runs from the Server and executes them.
FROM golang:1.27-alpine AS build
WORKDIR /src
ENV GOTOOLCHAIN=local CGO_ENABLED=0
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN go build -trimpath -o /out/buildbee-worker ./cmd/buildbee-worker

FROM alpine:3.24
RUN apk add --no-cache ca-certificates git \
    && adduser -D -u 10001 buildbee
COPY --from=build /out/buildbee-worker /usr/local/bin/buildbee-worker
USER buildbee
CMD ["buildbee-worker"]
